{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kimik31-bunya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi K3.1 Pro (Bunya MI355X)",
      "options": {
        "baseURL": "http://__HOST__:__PORT__/v1",
        "apiKey": "{env:KIMIK31_API_KEY}"
      },
      "models": {
        "__MODEL__": {
          "name": "Kimi K3.1 Pro",
          "limit": {
            "context": __CONTEXT__,
            "output": 32768
          },
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  }
}
